# ---------------------------------------------------------------------------
# Settings for the server. Copy this file to .env and edit it:
#
#     cp server/.env.example server/.env
#     nano server/.env
#     chmod 600 server/.env        <- it holds a camera password
#
# Lines starting with # are ignored. Anything you leave blank falls back to
# the value in config.py, or to the default shown in the comment.
#
# A real environment variable always beats this file, so you can try a setting
# for one run without editing anything:
#
#     PORT=9000 python server/stream_server.py
# ---------------------------------------------------------------------------


# === The camera ============================================================
# The full RTSP address of the camera this server watches. Leave it blank to
# use the camera already set in config.py.
#
# Format:  rtsp://<username>:<password>@<host>:<port>/<stream-path>
#
# If the password contains characters that are special in a URL, percent-encode
# them:  @ is %40,  # is %23,  / is %2F,  : is %3A,  ! is %21.
# "Admin@0192" is therefore written "Admin%400192".
#
# Pick the camera's SUB-stream where it has one (often subtype=1 or
# channels/102). It is typically 640x480 instead of 1920x1080, which is plenty
# for counting people and about nine times less work for the CPU.
CAMERA_URL=rtsp://admin:Admin%400192@172.20.100.138:554/cam/realmonitor?channel=1&subtype=1


# === Where the web page listens ============================================
# 0.0.0.0 means "answer on every network card", which is what lets your laptop
# reach it. Change it to 127.0.0.1 if you will only ever connect through an
# SSH tunnel - then the port is invisible to the rest of the network.
BIND_HOST=0.0.0.0
PORT=8000


# === Who may watch =========================================================
# Leave AUTH_USER blank and anyone who can reach the port can see the video.
# That may be fine on a private office network. Set both to put a username and
# password box in front of it.
#
# This is HTTP Basic authentication: the password is encoded, not encrypted.
# Over a LAN that is a sensible trade. Over the internet, put it behind an SSH
# tunnel or an HTTPS reverse proxy - see the README.
AUTH_USER=
AUTH_PASSWORD=


# === Video sent to your laptop =============================================
# JPEG quality, 1-100. 70 looks fine and costs about a third of what 95 does.
# Drop it to 50 on a slow link.
JPEG_QUALITY=70

# Shrink frames wider than this before sending. 0 = send at the camera's own
# size. Only affects what travels over the network: the model, the counting
# line and the counts all work on the full frame either way.
#
# Worth leaving alone. A 2560x1440 camera sent at full size costs about
# 50 Mbit/s, which will saturate a office link and show you nothing extra at
# the size the picture appears on screen; 960 wide is about 3 Mbit/s. A
# 640x480 sub-stream is below the limit already and is never enlarged.
STREAM_MAX_WIDTH=960


# === The model =============================================================
# openvino  - the exported .xml/.bin. Roughly twice as fast on an Intel or AMD
#             x86 CPU, and what the project is built around. Needs
#             `python export_openvino.py` to have been run on this machine.
# pytorch   - runs yolov8n.pt directly. Slower, but needs no export step and
#             works on CPUs OpenVINO does not support (ARM servers, some
#             virtual machines).
MODEL_BACKEND=openvino

# Inference size, a multiple of 32. Blank = the value in config.py (480).
# Smaller is faster and misses more distant people: 320 is about twice the
# speed of 480. With MODEL_BACKEND=openvino this MUST match the size the model
# was exported at, or the server stops at start-up and tells you so.
INFERENCE_SIZE=

# Which point on each person is tested against the line: foot or head.
# Blank = the value in config.py. Changeable from the web page at any time.
TRACK_POINT=foot

# Threads PyTorch may use. Leave blank unless you are measuring something -
# the default of 1 exists because torch's idle threads spin-wait and starve
# OpenVINO of the cores it is trying to use. Ignored for MODEL_BACKEND=pytorch,
# where 0 (= let torch decide) is used instead.
TORCH_THREADS=


# === Reconnection ==========================================================
# Seconds to wait before trying the camera again after it drops out. The
# server never gives up - there is nobody sitting in front of it to restart it.
RETRY_DELAY_SECONDS=5
